<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.uniquindio.proyectocinemauq.mvc.controlador.CarteleraControlador">
    <top>
        <VBox styleClass="encabezado">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="Cartelera" styleClass="titulo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Volver" onAction="#volver" styleClass="boton-volver"/>
            </HBox>
            <Label text="Paso 1 de 4 · Elige la función" styleClass="paso"/>
            <Separator/>
        </VBox>
    </top>
    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="18" right="24" bottom="12" left="24"/>
            </padding>
            <Label text="Elige una función y pulsa Elegir asientos." styleClass="ayuda" wrapText="true"/>
            <Label fx:id="vacio" text="No hay funciones disponibles por ahora." visible="false" managed="false" styleClass="subtitulo" wrapText="true"/>
            <ListView fx:id="listaFunciones" prefHeight="420"/>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT">
            <padding>
                <Insets top="8" right="24" bottom="18" left="24"/>
            </padding>
            <Button text="Elegir asientos" onAction="#elegirAsientos" styleClass="boton-primario"/>
        </HBox>
    </bottom>
</BorderPane>
