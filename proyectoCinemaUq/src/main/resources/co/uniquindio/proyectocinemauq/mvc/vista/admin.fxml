<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.uniquindio.proyectocinemauq.mvc.controlador.AdminControlador">
    <top>
        <VBox styleClass="encabezado">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label fx:id="titulo" text="Panel del administrador" styleClass="titulo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="botonEsquina" text="Cerrar sesión" onAction="#pulsarEsquina" styleClass="boton-volver"/>
            </HBox>
            <Separator/>
        </VBox>
    </top>
    <left>
        <VBox styleClass="panel-menu">
            <Label text="CinemaUQ" styleClass="marca-menu"/>
            <Label text="Administrador" style="-fx-text-fill: #E4DDD6;"/>
            <Button text="Inicio" onAction="#mostrarInicio" styleClass="boton-menu"/>
            <Button text="Películas" onAction="#mostrarPeliculas" styleClass="boton-menu"/>
            <Button text="Salas" onAction="#mostrarSalas" styleClass="boton-menu"/>
            <Button text="Funciones" onAction="#mostrarFunciones" styleClass="boton-menu"/>
            <Button text="Confitería" onAction="#mostrarConfiteria" styleClass="boton-menu"/>
            <Button text="Promociones" onAction="#mostrarPromociones" styleClass="boton-menu"/>
            <Button text="Clientes" onAction="#mostrarClientes" styleClass="boton-menu"/>
            <Button text="Compras" onAction="#mostrarCompras" styleClass="boton-menu"/>
            <Button text="Recargas" onAction="#mostrarRecargas" styleClass="boton-menu"/>
            <Button text="Estadísticas" onAction="#mostrarEstadisticas" styleClass="boton-menu"/>
            <Button text="Reportes" onAction="#mostrarReportes" styleClass="boton-menu"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contenido"/>
    </center>
</BorderPane>
